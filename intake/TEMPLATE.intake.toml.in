# declarations/<ID>/intake.toml - written by `bin/cc new intake <ID>` from intake/TEMPLATE.intake.toml.in (intake format v4, intake/FORMAT.toml).
# Replace every TODO. A closed field takes one of the words its comment lists; `bin/cc intake lint <id>` names each field still wrong.
# Write only what you read from metadata (a README, a listing, a header, the reader code), never from the data values.
# A section marked VARIANT holds exactly the fields of the value you choose for its first field: delete the lines of the other choices.
schema = 4
kind = "intake"
id = "<ID>"

[intake]
mode = "TODO"           # what you had seen of the data when you declared: PROSPECTIVE | RETROSPECTIVE_PREDECLARED | EXPLORATORY

[basis]
read = "TODO"           # what you read to write this: a list of { what = "...", class = README | LISTING | HEADER | UNITS_NOTE | ACQUISITION_NOTE | PAPER_METHODS | READER_CODE }

# [source]: VARIANT on kind
[source]
kind = "TODO"           # DEPOSIT (the files as deposited, read directly) | CONVERTED (a bank written by a declared conversion; also converted_from)
origin = "TODO"         # PLANTED (a generated bank) | EXPERIMENT
deposit = "TODO"        # where the data came from, one line
root = "TODO"           # <name>/<path>: a name of intake/ROOTS.toml, then the bank's directory under it
universe = "TODO"       # a glob, relative to root, of every file the deposit holds (the seal lists their names and sizes)
truth_side = "TODO"     # a list of file names on the truth side of a planted deposit; no stage may read them ([] for an experiment)
admissibility = "TODO"  # the deposit's class, read from its metadata: RAW | DECLARABLE | FIGURE_LEVEL | PROCESSED_UNDECLARABLE
converted_from = "TODO" # CONVERTED: "<cc-datasets>/<id>/raw", the deposit the conversion read

# [reader]: VARIANT on name
[reader]
name = "TODO"           # csv-curve-v1 (live; no other field) | table-curve-v1 (live; the three fields below) | P1 | L5 | F1 | C1 | C4 | npz-curve-v1 (not live yet; no other field)
comment = "TODO"        # table-curve-v1: a list of line prefixes that mark a comment line, e.g. ["#"] ([] for none)
# [reader.format]: table-curve-v1, VARIANT on kind
[reader.format]
kind = "TODO"           # COMMA | TAB | WHITESPACE | XLSX (then also: sheet = "<sheet name>")
# [reader.header]: table-curve-v1, VARIANT on kind
[reader.header]
kind = "TODO"           # SKIP (rows) | NAMES (rows, names) | NAMES_UNITS (rows, names, units) | NAMES_UNITS_IN_NAMES (rows, names,
                        # unit_syntax = PAREN for "T (K)" | SLASH for "T/K"; declare columns by the bare name): header line counts, after
                        # comment lines are dropped
rows = "TODO"           # how many header lines precede the data
names = "TODO"          # NAMES, NAMES_UNITS: the 1-based header line that holds the column names

# [selection]: VARIANT on layout
[selection]
layout = "TODO"         # PER_FILE (one file per curve: files, excluded) | LONG_TABLE (one file holds every curve: file, block, excluded);
                        # LONG_TABLE block: EXACT (a curve is a run of rows with one slow value) | FAST_RESTART (a curve ends where the fast
                        # knob turns back against its direction; its slow value is its first row's, and the census counts the distinct
                        # slow values inside it)
files = "TODO"          # PER_FILE: the curve files under root, in curve order, e.g. ["curve_000.csv", "curve_001.csv"]
excluded = "TODO"       # a list of { file = "...", why = "..." }: files in the universe that are not curves ([] when none); with files and the
                        # truth side, every file of the universe exactly once (the seal refuses UNIVERSE_NOT_PARTITIONED otherwise)
# [selection.slow]: VARIANT on source: where the slow knob's value of each curve comes from
[selection.slow]
source = "TODO"         # PER_FILE: LISTED (values) | FILE_KEY (key: the first cell of a header line; its second cell is the value) | NONE (no slow knob);
                        # LONG_TABLE: COLUMN (key, a column name or position)
values = "TODO"         # LISTED: one number per file of `files`, in that order, each written as text, e.g. ["-0.15", "-0.10"]

[knobs.slow]
name = "TODO"           # the slow knob: one curve per value
unit = "TODO"           # its unit

[knobs.fast]
name = "TODO"           # the fast knob: the points along each curve
unit = "TODO"           # its unit
source = "TODO"         # COLUMN | FILE_KEY
key = "TODO"            # its column: a name ("T") or a 1-based position (1), or its key
control = "SET"         # SET (set to each value, a grid; the v3 meaning) | MEASURED (read, not set: a ramp or a carried sweep; every row is a point)

[measured]
name = "TODO"           # the measured quantity
unit = "TODO"           # its unit
key = "TODO"            # its column: a name or a 1-based position, or its key
shape = "TODO"          # SCALAR_PER_LOCUS | SERIES_PER_LOCUS | PICTURE | POSITIONS
# [measured.uncertainty]: VARIANT on kind
[measured.uncertainty]
kind = "TODO"           # COLUMN (key) | NONE (no other field): the measured number's uncertainty column, if the file has one
key = "TODO"            # COLUMN: its column, a name or a 1-based position

# If the deposit does not state the order the rows were written in, declare `row_order = ACQUISITION` and `direction = UNORDERED`;
# ASCENDING and DESCENDING assert a monotone sweep and S4 refuses a file that is not one (plan 1160 A7).
[acquisition]
mode = "TODO"           # how the points were taken: INDEPENDENT | SWEEP_CARRIED | RAMP_CONTINUOUS | REPEATED_FRAMES
direction = "TODO"      # the order they were taken in along the fast knob: ASCENDING | DESCENDING | UNORDERED
row_order = "TODO"      # the order the rows are stored in: ASCENDING | DESCENDING | ACQUISITION

[replicate]
identity = "TODO"       # what makes two curves at one slow value replicates: NONE | SEED | RUN | SAMPLE | FILE; or SAME_FAST_VALUE:
                        # consecutive rows of one curve with an equal fast value are readings of one point
key = "TODO"            # the key that names a replicate; "" for NONE

[interval]
method = "TODO"         # block | iid | gamma | chains | STATED (the uncertainty column is each point's interval) | NONE (no interval); then add that method's fields (cc.toml [interval_fields.<method>]; STATED and NONE have none)

[bracket]
required = "TODO"       # the most this declaration requires of a bracket: CANDIDATE_BRACKET | VALIDATED_BRACKET

[[projection]]
lane = "TODO"           # PRIMARY | ALTERNATIVE
from = "TODO"           # the measured quantity it projects
to = "TODO"             # the name of what it yields
bias = "TODO"           # a projection key of intake/POLICY.toml: ARGMAX_FAST | MAX_MEASURED
keeps = "TODO"          # what the projection keeps, one sentence
discards = "TODO"       # what it discards, one sentence

[[bridge]]
lane = "TODO"           # PRIMARY | ALTERNATIVE
on = "TODO"             # the quantity the bridge joins
template = "TODO"       # a bridge key of intake/POLICY.toml: CHAIN_SLOW | PAIR_NEAREST_FAST
bias = "TODO"           # the same key as template

[shift]
c = "TODO"              # the one admissible step before A: x + c, a number (0.0 for none)
