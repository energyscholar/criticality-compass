# instruments/TEMPLATE.toml.in - read by `bin/cc new instrument <id>`, which substitutes <ID> and writes
# instruments/<ID>.toml. Replace every "TODO"; validate refuses any TODO left in, and `bin/cc run` refuses
# while this file has findings (a half-made instrument must not enter a result).
schema = 1
kind = "instrument"
module = "<ID>"                                # cc/instruments/<ID>.py; list it under checks.toml [roles].maths
operators = ["TODO"]                           # the kernel operators the stages call: A | B
unit = "TODO"                                  # point | pair | point-size
reports = []                                   # reported, never coded
arrays = ["TODO"]                              # keys of cc.toml [arrays]
axes = ["TODO"]                                # point | size | starts
relations = ["TODO"]                           # relation names an input must declare under [relations.<name>]
sidecar = []                                   # observable | block_map | conjugate | sinks | two_start
requires = []                                  # instruments that must be read and coded first (door order only)
door_values = []                               # refusal values this instrument's doors may return
flags = []                                     # cc.toml [flags] codes
pipeline = ["stage:reduce", "TODO"]            # stage:<f> = <module>.<f>; door:<f> = cc/door.py

[columns]
TODO = "TODO"                                  # column = the [eps] key its interval is read against
