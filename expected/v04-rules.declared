"4" = ["INDEP"]
"5" = ["COEXIST", "UNRES", "INDEP"]       # X9c.txt reads COEXIST on one marginal cell (L81 POS +0.0066); CC reads UNRES (the allowed difference, brief 0867 P3)
"6" = ["COEXIST"]
"8" = ["COEXIST"]
"10" = ["COEXIST"]

[needle_pair.x9c-potts]              # transcribed from results/X9c.txt BEFORE the CC run
"3" = ["SAME-WINDOW"]
"4" = ["SAME-WINDOW"]
"5" = ["HALF-PINNED"]
"6" = ["HALF-PINNED"]
"8" = ["PINNED-BETWEEN-PHASES"]
"10" = ["PINNED-BETWEEN-PHASES"]

[needle_pair.x5n-bilayer-2]          # predicted from the physics, not seen: at the confirmed stop both starts sit on the window
"0.0" = ["SAME-WINDOW", "HALF-PINNED"]   # NEVER PINNED-BETWEEN-PHASES (a continuous point) and NEVER CROSSED
"0.1" = ["SAME-WINDOW", "HALF-PINNED"]
"0.3" = ["SAME-WINDOW", "HALF-PINNED"]

[needle_pair.EVERY-OTHER-INPUT]      # the existing inputs declare no ordered-start GL (needle_o): NOT-MEASURED at every point
"*" = "NOT-MEASURED"

[[change]]
date = "2026-10-02"
points = ["*"]
why = """DECLARED BEFORE THE FIRST RUN under v03-rules (plan 0867 P1, G6). v03-rules = v02-rules + needle_pair. The ONLY cells of the \
signature domain whose verdict differs from v02-rules are those with needle in {DIS, ORD}, needle_pair PINNED-BETWEEN-PHASES and \
two_start COEXIST (NOT -> FIRST-ORDER; order OFF-WINDOW -> COEXIST-AT-WINDOW). An existing input declares no ordered-start level \
stack (no needle_o), so its needle_pair reads NOT-MEASURED and none of its points can sit in that cell: the predicted effect on \
fixture points is NONE (x4-ising-field-3 reads FLUCT, not COEXIST, so is not an exception). Every verdict above is the v02-rules lock \
carried over. A moved point is a finding, never an edit of this file"""

[[change]]
date = "2026-10-02"
