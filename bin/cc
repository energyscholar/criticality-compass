def inputs():
    d = ROOT / "inputs"
    names = [p.name for p in d.iterdir() if p.is_dir() and not p.name.startswith("TEMPLATE")] if d.is_dir() else []
    return sorted(names)


def opt(args, name, default=None):
    from intake_blind import flag   # the one flag parser: the word after `name`, else `default`
    return flag(args, name, default)


def positional(args, *flags):   # the words that are not flags and not the values the flags were GIVEN (a flag left out takes nothing away)
    return [a for a in args if not a.startswith("--") and a not in {opt(args, f) for f in flags}]


def help_text(advanced):
    tables = registry.config(ROOT)["defaults"]["tables"]
    if advanced:
        w = max(len(a) for a, _ in ADVANCED)
        body = "\n".join(f"  bin/cc {a.ljust(w)}  {b}" for a, b in ADVANCED)
        return f"cc - Criticality Compass   (ADVANCED)\n\n{body}\n"
    return f"""cc - Criticality Compass   (BASIC; `bin/cc help --advanced` lists every command)

  bin/cc show <input>                   every reading of an input, and each point's verdict (a declared report)
  bin/cc explain <input> <point>        the whole chain for one point: data -> verdict (a declared report)
  bin/cc run <input> | --all [--dry]    measure under the working rules; verdicts are declared reports (--dry writes nothing)
  bin/cc new case <id>                  start a case file (taxonomy) from the template
  bin/cc tables fork <from> <to>        copy a rulebook so you can edit it
  bin/cc tables drop <set>              delete a rulebook you no longer want
  bin/cc validate                       check every file; each problem says what to do next
  bin/cc check                          validate + tests + scoreboard; run it before a commit
  bin/cc hold <system> <world> --needle M  run a system by hand; the run is saved as a record (bin/cc hold --list)
  bin/cc navigate <input>               UNTESTED: walk a stored map (stored-map mode only); every line it prints is untested

inputs: {' '.join(inputs())}
rules in use: {tables}   (cc.toml [defaults] tables)
BLANK (...) means "CC does not know"; the word in brackets says why.

start: bin/cc show b7-at-line
"""


# ------------------------------------------------------------------ test, validate, check
def run_tests(names, skip=()):
    """Run the scripts of checks.toml [roles].tests by absolute path: [(stem, ok, last lines, seconds, all lines)]."""
    allt = [ROOT / f for f in tomllib.loads((ROOT / "checks.toml").read_text())["roles"]["tests"]]
    key = lambda t: (t.stem, t.name, str(t.relative_to(ROOT)))  # noqa: E731
    picked = [t for t in allt if (not names or set(names) & set(key(t))) and t.stem not in skip]
    missing = [n for n in names if not any(n in key(t) for t in allt)]
    keep = 10**6 if os.environ.get("CC_REGOLDEN") == "1" else 99 if VERBOSE else 8   # a regolden must list every file

    def one(t, slot):
        t0 = time.time()
        r = slots.run([sys.executable, str(t)], slot, capture_output=True, text=True, cwd=ROOT)   # the slot is held while the script runs (cc/slots.py)
        lines = (r.stdout + r.stderr).strip().splitlines()
        return (t.stem, r.returncode == 0, lines[-keep:], time.time() - t0, lines)   # the tail is for printing; the FULL output is for the scoreboard lines (plan 0881 P2.2)
    alone = set(registry.config(ROOT)["check"]["exclusive"])   # cc.toml [check] exclusive: test NAMES that run by themselves, after the parallel batch (plan 0881)
    batch = [t for t in picked if t.stem not in alone]
    done = dict(zip((t.stem for t in batch), slots.fan(one, batch, max(1, (os.cpu_count() or 3) - 2))))   # each script is its own subprocess in a host-wide slot; results in submission order
    done.update({t.stem: slots.fan(one, [t], 1)[0] for t in picked if t.stem in alone})
    return [done[t.stem] for t in picked], missing, allt   # the printed order is the checks.toml order, as before


def tests_absent():
    """The refusal text when a test checks.toml names is not on disk (a wheel carries only the tests the freeze gate names), else None."""
    gone = [t for t in tomllib.loads((ROOT / "checks.toml").read_text())["roles"]["tests"] if not (ROOT / t).is_file()]
    return (f"REFUSED: {len(gone)} of the tests checks.toml names are not in this workspace (first: {gone[0]}); an installed wheel carries only the tests a run needs.\n"
            "  Next: run the tests from a clone: git clone <repository> && pip install -e <clone>") if gone else None


def cmd_test(names):
    global VERBOSE
    if (gone := tests_absent()):
        print(gone)
        return 1
    regold = "--regolden" in names
    os.environ["CC_REGOLDEN"] = "1" if regold else ""
    VERBOSE = "-v" in names or regold
    os.environ["CC_VERBOSE"] = "1" if "-v" in names else ""
    classify = "--classify" in names
    if classify and not regold:
        print("--classify reads a regolden.\n  Next: bin/cc test --regolden --classify test_golden")
        return 1
    gold = ROOT / "tests" / "golden"
    before = {f.name: f.read_text() for f in gold.glob("*.txt")} if classify else {}
    res, missing, allt = run_tests([n for n in names if n not in ("-v", "--regolden", "--classify")])
    for n in missing:
        print(f"no test '{n}' in checks.toml [roles].tests\n  Next: bin/cc test <one of: "
              f"{' '.join(t.stem for t in allt)}>")
    for stem, ok, tail, _, _ in res:
        print(f"{'ok  ' if ok else 'FAIL'} {stem}")
        if not ok or (VERBOSE and not regold):
            print("\n".join("    " + ln for ln in tail))
    if regold:
        lines = [ln.strip() for _, _, tail, _, _ in res for ln in tail if ln.strip().startswith("REGOLDENED")]
        print("\n".join(lines) + f"\nregoldened {len(lines)} files: review them with git diff tests/golden/")
    if classify and not missing and all(ok for _, ok, _, _, _ in res):
        return report_classes(gold, before)
    return 1 if missing or not all(ok for _, ok, _, _, _ in res) else 0


def report_classes(gold, before):
    """Tag every changed line of a regolden by cc.toml [golden.classes]; any (e) line undoes the regolden (a STOP)."""
    import declare
    classes, found = registry.config(ROOT)["golden"]["classes"], []
    after = {f.name: f.read_text() for f in gold.glob("*.txt")}
    for name in sorted(after):
        if after[name] != before.get(name):
            found += [(name, k, ln) for k, ln in declare.classify_changes(classes, name, before.get(name), after[name])]
    tally = ", ".join(f"{k} {sum(1 for _, c, _ in found if c == k)}" for k in sorted({*classes, "e"}))
    print(f"classify: {len(found)} changed lines: {tally}")
    other = [(n, ln) for n, k, ln in found if k == "e"]
    if not other:
        print("classify: every changed line is class a-d: the regolden may be committed")
        return 0
    print("\n".join(f"  (e) {n}: {ln}" for n, ln in other[:40]))
    for name in after:   # undo: a regolden with an (e) line is not committed
        if name in before:
            (gold / name).write_text(before[name])
        else:
            (gold / name).unlink()
    print(f"classify: STOP: {len(other)} changed lines are class (e) OTHER; the regolden was undone.\n"
          "  Next: report them to the independent reviewer; do not commit")
    return 1


def cmd_validate(args):
    import declare
    found, n, declared = declare.validate_scored(ROOT, opt(args, "--input"), opt(args, "--tables"))
    print("\n".join(declare.fmt(f) for f in found))
    print("\n".join(declared)) if declared else None   # plan 0884 amendment 5: a declared refusal prints ONE line; the report: lines belong to the run transcript
    if "--advanced" in args:
        print("checked: " + ", ".join(f"{v} {k}" for k, v in sorted(n.items())))
    print(f"validate: NOT EVALUABLE HERE:{absent_lines([f for f in found if isinstance(f, declare.NotEvaluableHere)])}") if any(isinstance(f, declare.NotEvaluableHere) for f in found) else None
    print(f"validate: {len(found)} findings" if found else "validate: clean")
    if "--mvt" in args:
        import score
        print("-- MVT gate (report only; no status is changed)")
        rep = score.mvt(ROOT)
        print("\n".join(f"  {'PASS' if ok else 'FAIL'}  {name} :: {detail}" for name, ok, detail in rep))
        print(f"-- MVT {'PASS' if all(ok for _, ok, _ in rep) else 'FAIL'}")
    return 1 if found else 0


def tree_hash():
    """The git tree of the working files WITHOUT tests/BASELINE.txt (the file cannot name itself), or 'none'."""
    if not (ROOT / ".git").exists():
        return "none"
    env = {**os.environ, "GIT_INDEX_FILE": tempfile.mktemp(prefix="cc-index-")}
    git = lambda *a: subprocess.run(["git", *a], cwd=ROOT, env=env, capture_output=True, text=True, check=True).stdout.strip()  # noqa: E731
    try:
        git("read-tree", "HEAD")
        git("add", "-A", "--", ".")
        git("rm", "--cached", "-q", "--ignore-unmatch", RECORD)   # the record cannot name itself
        return git("write-tree")
    finally:
        Path(env["GIT_INDEX_FILE"]).unlink(missing_ok=True)


RECORD = "tests/BASELINE.txt"


def write_baseline(res, took):
    """A green check records what it ran on: tree, HEAD, and every test's NAME, status and seconds."""
    rows = [f"test {stem} {'ok' if ok else 'FAIL'} {sec:.1f}" for stem, ok, _, sec, _ in res]
    (ROOT / RECORD).write_text(f"tree {tree_hash()}\nhead {schema.git_head(ROOT)}\nseconds {took:.0f}\n" + "\n".join(rows) + "\n")


def cmd_baseline():
    """check --baseline: print the recorded baseline if its tree is this tree (exit 0), else say run the check."""
    f = ROOT / RECORD
    have = dict(ln.split(" ", 1) for ln in f.read_text().splitlines() if ln.startswith("tree ")) if f.is_file() else {}
    if have.get("tree") == tree_hash() != "none":
        print(f.read_text(), end="")
        print("baseline: this tree was checked green by the full check (read it instead of running bin/cc check)")
        return 0
    print("baseline: no recorded baseline for this tree.\n  Next: bin/cc check")
    return 1


def staged():
    """The paths the commit being made changes (the index against HEAD; under the hook, its GIT_INDEX_FILE), or None outside a git work tree."""
    r = subprocess.run(["git", "diff", "--cached", "--no-renames", "--name-only", "-z"], cwd=ROOT, capture_output=True, text=True)
    return r.stdout.split("\0")[:-1] if r.returncode == 0 else None


def absent_lines(absent):
    """One line per absent resource (plan 1273): how many checks it left not evaluated, and why; never one line per check."""
    by = {}
    for f in absent:
        by.setdefault(f.resource, []).append(f)
    return "".join(f"\n  {r}: {len(fs)} checks not evaluated here: {fs[0].reason}" for r, fs in sorted(by.items()))


def cmd_check(args):
    import declare
    if (gone := tests_absent()):
        print(gone)
        return 1
    if "--regolden" in args:
        print("check never regoldens.\n  Next: bin/cc test --regolden test_golden")
        return 1
    if "--baseline" in args:
        return cmd_baseline()
    t0, fast = time.time(), "--fast" in args
    found, _, declared = declare.validate_scored(ROOT)
    kinds = {declare.F: [], declare.NotEvaluableHere: []}   # plan 1273: a finding's TYPE says what it is evidence about (the files, or this host); total over the two
    for f in found:
        kinds[type(f)].append(f)
    content, absent = kinds.values()
    res, touched = sorted({f.resource for f in absent}), staged()
    hit = [x for x in touched if any(fnmatch.fnmatch(x, g) for g in registry.config(ROOT)["check"]["validate_domain"])] if touched is not None else ["(no git index here)"]
    if content:
        print("check: FAILED: content\n" + "\n".join(declare.fmt(f) for f in content) + absent_lines(absent) + "\n  Next: fix each finding above, then bin/cc check")
        return 1
    if absent and hit:
        print(f"check: NOT EVALUABLE HERE: {', '.join(res)}" + absent_lines(absent) + f"\n  this commit touches the validate domain (cc.toml [check] validate_domain): {' '.join(hit[:8])}"
              f"\n  Next: commit from a host with {' and '.join(res)} (the data root: --data-root PATH or CC_DATA_ROOT; the toolset: a clone holding registry.toml's source_commit)")
        return 3
    print("\n".join(declared) + "\n" if declared else "", end="")
    print(f"check: validate: not evaluated ({', '.join(res)} absent; this commit touches no file in the validate domain)" if absent else "check: validate clean")
    slow = registry.config(ROOT)["check"]["slow"] if fast else []
    res, _, _ = run_tests([], slow)
    bad = [r for r in res if not r[1]]
    skipped = f" (fast: {len(slow)} slow tests skipped; bin/cc check runs them)" if fast else ""
    print(f"check: {len(res) - len(bad)} tests passed, {len(bad)} failed{skipped}")
    print("\n".join("check: " + ln.strip() for _, _, _, _, full in res for ln in full if ln.strip().startswith("scoreboard ")))
    print("check: seconds per test\n" + "\n".join(f"  {sec:7.1f} s  {stem}" for stem, _, _, sec, _ in res))
    for stem, _, tail, _, _ in bad:
        print(f"check: FAILED: {stem}\n" + "\n".join("    " + ln for ln in tail) + f"\n  Next: bin/cc test {stem}")
    took, budget = time.time() - t0, registry.config(ROOT)["check"]["fast_budget_s"]
    if not bad:
        print(f"check: clean in {took:.0f} s (fast budget {budget} s)")
        if not fast:
            write_baseline(res, took)
            print(f"check: wrote {RECORD}")
        if fast and took > budget:
            worst = max(res, key=lambda r: r[3])
            print(f"  Next: move the slowest fast test ({worst[0]}, {worst[3]:.0f} s) to cc.toml [check].slow")
    return 1 if bad else 0


# ------------------------------------------------------------------ authoring
def cmd_author(cmd, args):
    import author
    sub, a = (args[0] if args else ""), args[1:]
    if (cmd, sub) == ("new", "case") and len(a) == 1:
        return author.new_case(ROOT, a[0])
    if (cmd, sub) == ("new", "input") and a:
        return author.new_input(ROOT, a[0], opt(a, "--like"), opt(a, "--points"), opt(a, "--pattern-point"),
                                opt(a, "--instruments"), opt(a, "--data-dir"), opt(a, "--label-format"),
                                opt(a, "--add-instrument"))
    if (cmd, sub) == ("new", "family") and len(a) == 1:
        return author.new_family(ROOT, a[0])
    if (cmd, sub) == ("new", "intake") and a:
        import intake_new
        code, text = intake_new.new(ROOT, a[0], opt(a, "--from-synth", ""))
        print(text)
        return code
    if (cmd, sub) == ("new", "instrument") and len(a) == 1:
        return author.new_instrument(ROOT, a[0])
    if (cmd, sub) == ("data", "add") and len(a) == 1:
        return author.data_add(ROOT, a[0])
    if (cmd, sub) == ("tables", "fork") and len(a) == 2:
        return author.fork(ROOT, *a)
    if (cmd, sub) == ("tables", "drop") and a:
        return author.drop(ROOT, a[0], "--with-results" in a)
    if (cmd, sub) == ("tables", "split") and a and all(opt(a, f) for f in ("--column", "--value", "--verdict")):
        return author.split(ROOT, a[0], opt(a, "--column"), opt(a, "--value"), opt(a, "--verdict"))
    print(f"usage: bin/cc {cmd} <...>\n  Next: bin/cc help --advanced")
    return 1


def cmd_intake(args):
    import intake
    return intake.cli(ROOT, args)


# ------------------------------------------------------------------ run, freeze
def structure_gate():
    """Run checks.py (the hook cannot see subprocesses). Returns the refusal text, or None when the checker SAID clean.
    The checker's last line is `-- N finding(s)`: a verdict exists only when that line is there and the exit code agrees with N.
    Anything else (no checker, a crash, no trailer) is a REFUSAL, never 'clean' (plan 0929 blocker b: an empty output is not a zero)."""
    if TOOLS is None:
        return ("REFUSED: no structure checker is named, so no run can be shown to obey the structure rules.\n"
                "  Next: set CC_STRUCTURE_CHECKS to the directory that holds checks.py")
    tool = TOOLS / "checks.py"
    if not tool.is_file():
        return (f"REFUSED: the structure checker {tool} is not there, so no run can be shown to obey the structure rules.\n"
                "  Next: install the structure checker, or point CC_STRUCTURE_CHECKS at the directory that holds checks.py")
    r = subprocess.run([sys.executable, str(tool), str(ROOT)], capture_output=True, text=True)
    trailer = [ln for ln in r.stdout.splitlines() if re.fullmatch(r"-- \d+ finding\(s\)", ln)]
    if not trailer or r.returncode != (1 if int(trailer[-1].split()[1]) else 0):
        return (f"REFUSED: the structure checker gave no verdict (exit {r.returncode}).\n"
                f"{(r.stderr or r.stdout).strip()[-400:]}\n  Next: run {sys.executable} {tool} {ROOT} and fix what stops it")
    found = [ln for ln in r.stdout.splitlines() if ln[:2] in ("C1", "C2", "C3", "C6", "C7", "C8", "W0")]
    for ln in found:
        if ln.startswith("C7"):
            key = ln.split()[3]
            fork = f", then bin/cc tables fork {key.split('/')[1]} <new-name> and edit the copy"
            return (f"REFUSED: {key} changed after it was frozen.\n"
                    f"  Next: git checkout -- {key}{fork if key.startswith('tables/') else ''}")
    if found:
        return ("\n".join(found) + "\n  Next: fix each finding above; "
                "science files may not branch (KERNEL-IN-CC.md explains why)")
    return None


def run_one(name, tables, dry, how=None):
    """(refusal text, None) or (None, result): checks first, then the run."""
    import author
    import declare
    import detect
    sets = declare.sets_of(ROOT)
    if name not in inputs():
        return f"no input '{name}'. Inputs: {' '.join(inputs())}\n  Next: bin/cc run <one of these>", None
    if tables not in sets:
        return f"no table set '{tables}'. Sets: {' '.join(sets)}\n  Next: bin/cc run {name} --tables <one of these>", None
    gate = structure_gate()
    if gate:
        return gate, None
    half = [f for q in sorted((ROOT / "instruments").glob("*.toml")) for f in declare.check_file(q, ROOT)]
    if half:   # plan 0864 R11: a half-made instrument must not enter a result
        return "REFUSED: the instrument registry has findings.\n" + "\n".join(declare.fmt(f) for f in half), None
    found, _ = declare.validate(ROOT, name, tables)
    if found:
        return "\n".join(declare.fmt(f) for f in found), None
    if schema.result_rel(name, tables) in author.frozen(ROOT)[0] and not dry:
        return (f"REFUSED: {schema.result_rel(name, tables)} is frozen (a frozen result never changes).\n"
                f"  Next: bin/cc tables fork {tables} <new-name>, edit tables/<new-name>/verdict.toml, "
                f"then bin/cc run {name} --tables <new-name>"), None
    try:
        res, got = detect.run_keyed(name, tables, not dry)
        (how if how is not None else []).append(got)
        if not dry:
            stamp_pins(res)
        return None, res
    except detect.Refused as e:   # plan 0973 F8: only a declared refusal is text; a ValueError from a defect propagates
        return str(e), None


def stamp_pins(res):
    """Record, in a result written now, which toolset commit supplied each pinned sampler file (transducer.update; plan 0929 D-0929-5).
    Done here, not in cc/detect.py: detect.py is in the measurement closure, and a provenance field must not move measure_hash.
    A frozen record is never touched."""
    import transducer
    path = schema.result_path(ROOT, res["input"], res["tables"])
    t = tomllib.loads((ROOT / "inputs" / res["input"] / "transducer.toml").read_text()).get("transducer", {})
    import declare
    pins = transducer.supplied(t.get("update", []), declare.Ctx(ROOT).data_root.parent)
    import author
    frozen = author.frozen(ROOT)[0]
    if pins and path.is_file() and schema.result_rel(res["input"], res["tables"]) not in frozen and res.get("pins") != pins:
        res["pins"] = pins
        path.write_text(json.dumps(res, indent=1) + "\n")


def reverdict_one(name, new, old):
    """(refusal text, None) or (None, result): re-verdict the stored result of `name` under set `new`."""
    import author
    import declare
    import score
    import view
    sets = declare.sets_of(ROOT)
    msg, res = load_result(name, old, "reverdict")
    if res is None:
        return msg, None
    if new not in sets:
        return f"no table set '{new}'. Sets: {' '.join(sets)}\n  Next: bin/cc reverdict {name} --tables <one of these>", None
    gate = structure_gate()
    found, _ = declare.validate(ROOT, name, new)
    if schema.result_rel(name, new) in author.frozen(ROOT)[0]:
        return f"REFUSED: {schema.result_rel(name, new)} is frozen (a frozen result never changes).\n  Next: pick another table set", None
    gone = view.stale(res)
    refusal = score.reverdict_refusal(res, new)
    first = gate or "\n".join(declare.fmt(f) for f in found) or gone or refusal
    if first:
        return first, None
    import detect
    commit = schema.git_head(ROOT)
    out = score.reverdict_result(res, detect.load_tables(new), commit)
    (ROOT / "results" / f"{out['run_id']}.json").write_text(json.dumps(out, indent=1) + "\n")
    return None, out


def cmd_reverdict(args):
    new, old = opt(args, "--tables"), opt(args, "--from") or registry.config(ROOT)["defaults"]["tables"]
    pos = positional(args, "--tables", "--from")
    if len(pos) != 1 or not new:
        print("usage: bin/cc reverdict <input> --tables SET [--from SET]\n  Next: bin/cc help --advanced")
        return 1
    msg, res = reverdict_one(pos[0], new, old)
    if res is None:
        print(msg)
        return 1
    import score
    import view
    print(f"reverdict {res['derived_from']} -> {schema.result_rel(res['input'], res['tables'])} (no instrument was run)")
    return emit(view.show(res, score.join(pos[0]), MODE, frozen_note(res)))


def cmd_family(args):
    import family
    tables = opt(args, "--tables") or registry.config(ROOT)["defaults"]["tables"]
    pos = positional(args, "--tables")
    if len(pos) != 1:
        print("usage: bin/cc family <id> [--tables SET]\n  Next: bin/cc help --advanced")
        return 1
    msg, got = family.run(ROOT, pos[0], tables)
    print(msg if got is None else "\n".join(family.show(*got)))
    return got is None


def frozen_note(res, dry=False):
    import author
    frozen = author.frozen(ROOT)[0]
    return "(dry: nothing written)" if dry else "(frozen)" if schema.result_rel(res["input"], res["tables"]) in frozen else "(not frozen)"


def emit(lines):
    print("\n".join(lines))
    return 1 if lines[0].startswith("REFUSED") else 0


def cmd_run(args):
    tables = opt(args, "--tables") or registry.config(ROOT)["defaults"]["tables"]
    pos = positional(args, "--tables")
    names = inputs() if "--all" in args else pos
    if not names:
        print(f"no input named.\n  Next: bin/cc run <one of: {' '.join(inputs())}>   (or --all)")
        return 1
    bad, how = 0, []
    for name in names:
        msg, res = run_one(name, tables, "--dry" in args, how)
        if res is None:
            bad += 1
            print(msg if len(names) == 1 else f"{name}: REFUSED: {msg.splitlines()[0]}")
            import declare
            reports = declare.geometry_reports(ROOT, name)
            print("\n".join(reports)) if reports else None   # plan 0884 amendment 5: the L8-d report lines belong to the run transcript, refused or not
            continue
        import score
        import view
        view_lines = view.show(res, score.join(name), MODE, frozen_note(res, "--dry" in args))
        print(f"run {res['run_id']}" + ("" if "--dry" in args else f" -> {schema.result_rel(res['input'], res['tables'])}"))
        bad += emit(view_lines)
        if len(names) > 1:
            print(f"{name}: ran")
    if len(names) > 1:
        print(f"run: {how.count('measured')} measured, {how.count('stored')} reused from the stored result, "
              f"{how.count('re-verdicted')} re-verdicted from another set, {bad} refused")
    return 1 if bad else 0


def load_result(name, tables, cmd):
    """(refusal text, None) or (None, result): a result must exist before it can be shown."""
    if name not in inputs():
        return f"no input '{name}'. Inputs: {' '.join(inputs())}\n  Next: bin/cc {cmd} <one of these>", None
    p = schema.result_path(ROOT, name, tables)
    if not p.is_file():
        return (f"no result for {name} under {tables} yet.\n"
                f"  Next: bin/cc run {name}   (or --dry to look without writing)"), None
    return None, json.loads(p.read_text())


def cmd_show(args, explain):
    import score
    import view
    tables = opt(args, "--tables") or registry.config(ROOT)["defaults"]["tables"]
    pos = positional(args, "--tables")
    cmd = "explain" if explain else "show"
    if len(pos) != 1 + explain:
        print(f"usage: bin/cc {cmd} <input>{' <point>' * explain}\n  Next: bin/cc help")
        return 1
    msg, res = load_result(pos[0], tables, cmd)
    if res is None:
        print(msg)
        return 1
    points = [s["point"] for s in res["signature"]]
    pairs = ["->".join(p["pair"]) for p in res.get("pairs", [])]
    if explain and pos[1] in pairs:
        return emit(view.explain_pair(res, pos[1], MODE))
    if explain and pos[1] not in points:
        print(f"{pos[0]} has no point '{pos[1]}'. Points: {' '.join(points + pairs)}\n  Next: bin/cc explain {pos[0]} <one of these>")
        return 1
    jn = score.join(pos[0])
    if explain:
        return emit(view.explain(res, pos[1], jn, MODE))
    return emit(view.show(res, jn, MODE, frozen_note(res)))


def all_results():
    return [json.loads(p.read_text()) for p in sorted((ROOT / "results").glob("*.json"))]


def cmd_diff(args):
    """tabulate --diff A B: print the diff and write NOTHING (plan 0864 O2/R14)."""
    import detect
    import score
    results = all_results()
    a, b = args[args.index("--diff") + 1:][:2]
    ra, rb = ([r for r in results if r["tables"] == t] for t in (a, b))
    lines, _, _ = score.diff(detect.load_tables(a), detect.load_tables(b), ra, rb)
    print("\n".join(lines) + "\ntabulate --diff: wrote nothing (bin/cc tabulate writes SIGNATURE-TABLE.md and docs/verdict-table.html)")
    return 0


def cmd_tabulate(args):
    import declare
    import family
    import score
    if "--diff" in args:
        return cmd_diff(args)
    results = all_results()
    with declare.hashing_once():   # read-only: each data file is hashed once, not once per result that read it
        md, found = score.tabulate(results)
    (ROOT / "SIGNATURE-TABLE.md").write_text(md)
    (ROOT / "docs").mkdir(exist_ok=True)
    (ROOT / "docs" / "verdict-table.html").write_text(score.page(results, None, []))
    print("\n".join(found) + ("\n" if found else "") + f"tabulate: {len(results)} results -> SIGNATURE-TABLE.md, "
          "docs/verdict-table.html")
    return 1 if any(not isinstance(f, family.Null) for f in found) else 0   # plan 0894 P3: a declared null is printed, not a failure


def freeze_files(rid, read, vectors):
    """The repo files to freeze for one result: itself, the vectors it names, what it read, and its table set."""
    tdir = f"tables/{rid.split('@')[1]}"
    want = [schema.result_rel(*rid.split("@")), vectors] + [k for k in read if not k.startswith((registry.config(ROOT)["data"]["name"] + "/", "tables/"))]
    return tdir, want + [f"{tdir}/{q.name}" for q in sorted((ROOT / tdir).iterdir())]


def committed_measure_hash(name):
    """The measurement key (declare.measure_hash) of input `name` as the HEAD tree computes it: HEAD's cc/ is unpacked and hashed."""
    import declare
    import detect
    mods = [detect.instrument(n)[0]["module"] for n in detect.load_input(name)["instruments"]]
    if not (ROOT / ".git").exists():
        return declare.measure_hash(ROOT, mods)
    with tempfile.TemporaryDirectory() as t:
        subprocess.run(["tar", "-x", "-C", t], input=subprocess.run(["git", "-C", str(ROOT), "archive", "HEAD", "cc"], capture_output=True, check=True).stdout, check=True)
        return declare.measure_hash(t, mods)


def cmd_freeze(args):
    import declare
    import view
    tables = opt(args, "--tables") or registry.config(ROOT)["defaults"]["tables"]
    pos = positional(args, "--tables")
    done = (ROOT / "results").is_dir() and "--all" in args
    ids = sorted(p.stem for p in (ROOT / "results").glob(f"*@{tables}.json")) if done else pos
    if not ids:
        print(f"no result to freeze.\n  Next: bin/cc run <input>, then bin/cc freeze <input>@{tables}")
        return 1
    for rid in ids:
        name, tset = rid.split("@")
        p = schema.result_path(ROOT, name, tset)
        if not p.is_file():
            print(f"no result '{rid}'.\n  Next: bin/cc run {name}")
            return 1
        res = json.loads(p.read_text())
        read, bad = res["read"], view.stale(res)
        if bad:
            print(bad)
            return 1
        frozen = json.loads((ROOT / "FROZEN.json").read_text())
        parent = res.get("derived_from")   # a re-verdicted result measured nothing: it stands on its parent, which is judged when frozen
        judged = schema.result_rel(name, tset) in frozen["files"] or (parent is not None and schema.result_rel(*parent.split("@")) in frozen["files"])   # a frozen result was judged when it was frozen
        if not judged and res.get("measure_hash") != committed_measure_hash(name):
            print(f"REFUSED: {rid} was not made by the committed measurement (its measure_hash differs from the HEAD tree's, "
                  "or it records none; code_hash is provenance and is not compared).\n"
                  f"  Next: commit the code, then bin/cc run {name} --tables {tset}, then bin/cc freeze {rid}")
            return 1
        tdir, want = freeze_files(rid, read, res["vectors"])
        new = [w for w in want if w not in frozen["files"]]
        if TOOLS is None:
            print("REFUSED: no structure checker is named, so nothing can be frozen.\n  Next: set CC_STRUCTURE_CHECKS to the directory that holds freeze.py")
            return 1
        freeze = [sys.executable, str(TOOLS / "freeze.py"), str(ROOT)]
        subprocess.run(freeze + ["files", *new], check=True, capture_output=True)
        if tdir not in frozen["dirs"]:
            subprocess.run(freeze + ["dirs", tdir], check=True, capture_output=True)
        print(f"froze {len(new)} files, {int(tdir not in frozen['dirs'])} dir for {rid}")
    return 0


# ------------------------------------------------------------------ mutate
def cmd_mutate(args):
    """Copy the repo, apply one mutation to the copy, run the named tests there, print RED/GREEN, delete it."""
    usage = "mutate: need <relpath> (--sed EXPR | --py EXPR) -- <test> ...\n  Next: bin/cc mutate <relpath> --sed EXPR -- <test> ..."
    if "--" not in args:
        print("mutate: no test named.\n  Next: bin/cc mutate <relpath> --sed EXPR -- <test> ...")
        return 1
    head, tests = args[:args.index("--")], args[args.index("--") + 1:]
    if not tests or len(head) != 3 or head[1] not in ("--sed", "--py"):
        print(usage)
        return 1
    rel, mode, expr = head
    tmp = Path(tempfile.mkdtemp(prefix="cc-mutate-"))
    try:
        copy = tmp / "repo"
        shutil.copytree(ROOT, copy, ignore=shutil.ignore_patterns(".git", "__pycache__"))
        for p in [copy, *copy.rglob("*")]:
            p.chmod(p.stat().st_mode | stat.S_IWUSR)
        target = copy / rel
        old = target.read_text()
        if mode == "--sed":
            new = subprocess.run(["sed", "-e", expr], input=old, capture_output=True, text=True, check=True).stdout
        else:
            new = eval(expr, {"s": old})
        if new == old:
            print(f"mutate: the mutation leaves {rel} unchanged.\n  Next: fix the expression so it changes the file")
            return 1
        target.write_text(new)
        r = subprocess.run([sys.executable, str(copy / "bin" / "cc"), "test", *tests], capture_output=True, text=True)
        for ln in r.stdout.splitlines():
            if ln[:4] in ("ok  ", "FAIL"):
                print(("GREEN " if ln[:2] == "ok" else "RED   ") + ln[5:])
            elif ln.startswith("    "):
                print("      " + ln.strip())   # the last lines of a RED test (a breaker prints BROKEN <id>)
        print(r.stderr, end="")
        return 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def cmd_bench(a):   # plan 0932: the frozen benchmark suite as a manifest (cc/bench.py)
    import bench
    c = schema.Ctx(ROOT)
    return bench.main(a, {"cc": ROOT, "data": c.data_root}, ROOT)


def _stored_map(args):
    import navmap
    log = opt(args, "--access-log")
    return navmap.main(ROOT, (args + [""])[0], Path(log).resolve() if log else None)   # no input given: the typed refusal names the inputs


def _family(a):
    import navfamily
    return navfamily.family(ROOT, (a + [""])[0])


def _score(a):
    import navfamily
    return navfamily.score(ROOT, (a + ["", ""])[0], (a + ["", ""])[1])


NAVIGATE = {"family": _family, "score": _score, "--oracle": lambda a: oracle.cli(ROOT, a)}   # plan 1176 D: family mode (cc/navfamily.py); any other first word is a stored-map input


def cmd_navigate(args):
    """navigate <input> [--access-log PATH]: stored-map mode (plan 1114); navigate family <id> | score <id> <checkpoints.toml>: family mode
    (plan 1176, cc/navfamily.py over the frozen cc/linenav.py). docs/navigate.md. UNTESTED: every output's first line says so."""
    sub = (args + [""])[0]
    lines, status = NAVIGATE[sub](args[1:]) if sub in NAVIGATE else _stored_map(args)
    print("\n".join(lines))
    return status


def cmd_hold(args):
    """hold <system> <world> --needle MODE [--seed N] [--wall S] [--out DIR] [--dry] | --list | --verify DIR: plan 1634 (manual/hold.py). The driver runs from ROOT;
    COMPASS_CWD is where the user stands, so a relative --out or path lands there, never inside an installed package."""
    return subprocess.run([sys.executable, "-m", "manual.hold", *args], cwd=ROOT, env={**os.environ, "COMPASS_CWD": os.getcwd()}).returncode


def cmd_chain(args):
    """chain <id> --grid <grid.toml> [--with <id2>]: plan 1205 P2 (cc/chain.py): every cell of a declared settings grid over one intake family,
    the data read once; typed rows in results/chain/<id>.json and one sentence per lane."""
    import chain
    lines, status = chain.run(ROOT, (args + [""])[0], opt(args, "--grid"), opt(args, "--with"))
    print("\n".join(lines))
    return status


def cmd_registry(args):
    """registry pull <toolset-commit> [--toolset DIR]: the ONLY writer of registry.toml and of the cc.toml [registry] pin (plan 1016). Reads the toolset's REGISTRY.toml at that commit through git."""
    import registry
    if len(args) < 2 or args[0] != "pull":
        print("registry: need pull <toolset-commit>.\n  Next: bin/cc registry pull <toolset-commit> --toolset <dir>   (or set CC_TOOLSET)")
        return 1
    ts = opt(args, "--toolset", os.environ.get("CC_TOOLSET"))
    if not ts:
        print("registry pull: no toolset repository is named.\n  Next: bin/cc registry pull <toolset-commit> --toolset <dir>   (or set CC_TOOLSET)")
        return 1
    git = lambda *a: subprocess.run(["git", "-C", ts, *a], capture_output=True, text=True)  # noqa: E731
    commit, blob, text = git("rev-parse", "--verify", args[1] + "^{commit}"), git("rev-parse", f"{args[1]}:taxonomy/REGISTRY.toml"), git("show", f"{args[1]}:taxonomy/REGISTRY.toml")
    if commit.returncode or blob.returncode or text.returncode:
        print(f"registry pull: cannot read taxonomy/REGISTRY.toml at '{args[1]}' in the toolset.\n  Next: pass a commit that holds it")
        return 1
    try:
        out = registry.project(text.stdout, blob.stdout.strip(), commit.stdout.strip())
    except ValueError as e:
        print(f"registry pull: REFUSED: {e}\n  Next: fix the ids in the toolset REGISTRY.toml, then pull again")
        return 1
    (ROOT / "registry.toml").write_text(out)
    cc = (ROOT / "cc.toml").read_text()
    (ROOT / "cc.toml").write_text(re.sub(r'(?m)^(\[registry\]\nsha256 = ")[0-9a-f]{64}', lambda m: m.group(1) + registry.sha256_of(ROOT / "registry.toml"), cc))
    print(f"registry pull: registry.toml from toolset {commit.stdout.strip()[:12]} (REGISTRY.toml blob {blob.stdout.strip()[:12]}); pin sha256 {registry.sha256_of(ROOT / 'registry.toml')[:12]}")
    return 0


def main(argv):
    global MODE
    advanced = "--advanced" in argv
    MODE = "advanced" if advanced else registry.config(ROOT)["defaults"]["mode"]
    argv = [a for a in argv if a != "--advanced"]
    if "--data-root" in argv:   # global: where the data IS on this machine (the declared name in cc.toml [data] root is unchanged)
        i = argv.index("--data-root")
        if i + 1 >= len(argv):
            print("--data-root needs a path.\n  Next: bin/cc --data-root <dir> <command>")
            return 1
        schema.DATA_ROOT_FLAG = argv[i + 1]
        argv = argv[:i] + argv[i + 2:]
    cmd, rest = (argv[0] if argv else "help"), argv[1:]
    if cmd in ("help", "--help", "-h"):
        print(help_text(advanced), end="")
        return 0
    table = {"show": lambda a: cmd_show(a, False), "explain": lambda a: cmd_show(a, True), "tabulate": cmd_tabulate,
             "test": cmd_test, "run": cmd_run, "reverdict": cmd_reverdict, "family": cmd_family, "freeze": cmd_freeze, "check": cmd_check, "mutate": cmd_mutate, "bench": cmd_bench, "registry": cmd_registry, "intake": cmd_intake, "navigate": cmd_navigate, "chain": cmd_chain, "hold": cmd_hold,
             "validate": lambda a: cmd_validate(a + (["--advanced"] if advanced else []))}
    if cmd in table:
        try:
            return table[cmd](rest)
        except slots.Refused as e:   # a pool setting refused by name (plan 1559)
            print(e)
            return 1
    if cmd in ("new", "data", "tables"):
        return cmd_author(cmd, rest)
    print(f"unknown command '{cmd}'.\n  Next: bin/cc help")
    return 1


sys.exit(main(sys.argv[1:]))
