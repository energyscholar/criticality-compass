VERBOSE = False
MODE = "basic"
TOOLS = Path(os.environ["CC_STRUCTURE_CHECKS"]) if os.environ.get("CC_STRUCTURE_CHECKS") else None   # NAMED by CC_STRUCTURE_CHECKS, never a default location (plan 0985); the structure checker (checks.py, freeze.py); CC_STRUCTURE_CHECKS moves it (plan 0929)
